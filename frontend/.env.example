# Copiá este archivo como .env.local y ajustá los valores.
# No coloques secretos aquí: todas las variables VITE_* quedan visibles en el navegador.

# true  -> usa el proveedor DEMO (datos ficticios, sin backend).
# false -> usa el cliente HTTP contra FastAPI.
VITE_DEMO_MODE=true

# URL base del backend FastAPI (solo se usa cuando VITE_DEMO_MODE=false).
VITE_API_BASE_URL=http://localhost:8000

# Tamaño máximo de archivo aceptado por la validación preliminar del frontend (MB).
VITE_MAX_UPLOAD_MB=25
