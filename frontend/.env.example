# Copiá este archivo como .env.local y ajustá los valores.
# No coloques secretos aquí: todas las variables VITE_* quedan visibles en el navegador.

# true  -> usa el proveedor DEMO (datos ficticios, sin backend).
# false -> usa el cliente HTTP contra FastAPI.
VITE_DEMO_MODE=true

# Perfilado real de CSV/XLSX con FastAPI + Pandas (POST /api/datasets/profile),
# manteniendo DEMO para el asistente y los resultados.
# false -> sin llamadas al backend (obligatorio en la demo pública de Cloudflare).
# true  -> solo para ejecución local con el backend en marcha.
VITE_BACKEND_PROFILING=false

# URL base del backend FastAPI (se usa con VITE_DEMO_MODE=false o VITE_BACKEND_PROFILING=true).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Tamaño máximo de archivo aceptado por la validación preliminar del frontend (MB).
VITE_MAX_UPLOAD_MB=25
