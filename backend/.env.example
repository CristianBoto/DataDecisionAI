# Copiá este archivo como .env y completá los valores. NUNCA subas el .env al repositorio.

# development | test | production. Un valor desconocido impide arrancar.
# En producción el backend NO arranca si falta TURNSTILE_SECRET_KEY, si CORS_ORIGINS
# no es https o si no se confirma el disco persistente.
ENVIRONMENT=development
# Orígenes del frontend autorizados para llamar a la API y cargar archivos.
# Una carga con otro Origin (incluido "null") se rechaza con 403 antes de leer el archivo.
# CORS no es autenticación: toda ruta de datos exige además una sesión de invitación.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Persistencia mínima (SQLite): invitaciones, sesiones y consumo de la IA (sin datasets).
# En producción: ruta ABSOLUTA en un disco persistente (por ejemplo, sqlite:////var/data/datadecision.db)
# y PERSISTENT_STORAGE_CONFIRMED=true. Un disco efímero borraría el presupuesto consumido.
DATABASE_URL=sqlite:///./data/datadecision.db
PERSISTENT_STORAGE_CONFIRMED=false

# Límites de archivo (en la beta pública conviene bajarlos, por ejemplo 10 MB y 1000000 de celdas).
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
MAX_DATASET_CELLS=5000000
# Tareas pesadas simultáneas (perfilado y ejecución). Sin definir: 1 en producción (Render Starter,
# 512 MB) y 2 en desarrollo. Solo subir a 2 con más memoria.
# MAX_HEAVY_TASKS=

# --- Acceso por invitación ------------------------------------------------------
# Las invitaciones se crean desde el servidor: python -m app.cli invite --label "Docente" --days 14
SESSION_TTL_HOURS=12
MAX_SESSIONS_PER_INVITATION=3
# Cloudflare Turnstile: clave SECRETA solo aquí (la clave del sitio va en el frontend).
# Vacía en desarrollo: no se exige verificación (la sesión de invitación sí).
TURNSTILE_SECRET_KEY=
# Dominio del frontend que debe resolver el desafío (obligatorio en producción: datadecisionai.pages.dev).
TURNSTILE_EXPECTED_HOSTNAME=
# Proxies de confianza que agregan X-Forwarded-For delante del backend (0 en local; 1 en Render).
# Producción exige 1 o más. Nunca usar --forwarded-allow-ips="*" en uvicorn.
FORWARDED_IP_HOPS=0
# Límites por IP (una sola instancia del backend).
RATE_LIMIT_PER_MINUTE=120
REDEEM_ATTEMPTS_PER_15_MINUTES=10

# --- IA externa (Fase 3B.2) ----------------------------------------------------
# Clave de OpenAI: SOLO en este archivo .env del backend (excluido de Git).
# Nunca en variables VITE_*, en el frontend, en Cloudflare ni en el chat.
OPENAI_API_KEY=

# Envío a la IA externa. Deshabilitado por defecto.
# Aun con true, cada mensaje exige revisar y autorizar su contenido exacto (uso único).
AI_ENABLED=false

# Modelo y razonamiento (los tokens de razonamiento se cobran como salida).
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
# Precio por millón de tokens: solo si el modelo no está en la tabla interna.
# OPENAI_PRICE_INPUT_PER_1M=
# OPENAI_PRICE_OUTPUT_PER_1M=

# Límites aplicados en el backend.
AI_TIMEOUT_SECONDS=40
AI_MAX_OUTPUT_TOKENS=2500
AI_MAX_INPUT_TOKENS=8000
# Presupuesto GLOBAL acumulado en USD, registrado en la base SQLite (sin contenido).
# Complementa, no reemplaza, el límite de gasto del proyecto en OpenAI Platform.
AI_BUDGET_USD=1.00
# Cuotas por visitante (invitación) y tope diario del servicio.
AI_USER_BUDGET_USD=0.10
AI_USER_DAILY_REQUESTS=15
AI_GLOBAL_DAILY_REQUESTS=150
# Autorización por conversación (opcional para el usuario): vence y tiene un máximo de mensajes.
AI_CONVERSATION_TTL_MINUTES=30
AI_CONVERSATION_MAX_MESSAGES=20
