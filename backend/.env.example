# Copiá este archivo como .env y completá los valores. NUNCA subas el .env al repositorio.

ENVIRONMENT=development
# Orígenes del frontend local autorizados para llamar a la API y cargar archivos.
# Una carga con otro Origin (incluido "null") se rechaza con 403 antes de leer el archivo.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Base de datos (etapa futura). SQLite para desarrollo.
DATABASE_URL=sqlite:///./data/datadecision.db

# Carpeta donde se guardarán los datasets subidos (excluida de git).
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# Clave de OpenAI (etapa futura). Se usa SOLO en el backend: nunca en variables VITE_*.
OPENAI_API_KEY=

# Envío de información a la IA externa. Deshabilitado por defecto.
# Aun con true, cada envío exige revisar y autorizar el contenido exacto.
# En la Fase 3B.1 no existe todavía ninguna llamada real a OpenAI.
AI_ENABLED=false
