# ============================================================
# DataDecision AI — archivos que NUNCA deben subirse a git
# ============================================================

# --- Secretos y variables de entorno ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Node / Vite (frontend) ---
node_modules/
dist/
dist-ssr/
coverage/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# --- Python (backend) ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Datos del usuario, bases locales y archivos generados ---
backend/data/
backend/uploads/
backend/reports/
backend/exports/
*.db
*.sqlite
*.sqlite3
# Datasets subidos o de prueba local (los ejemplos versionados irían en docs/ con !)
*.csv
*.xlsx
*.xls
# Informes generados
backend/**/*.pdf
backend/**/*.docx
backend/**/*.pptx

# --- Editores y sistema operativo ---
.vscode/*
